{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RKE Report Intelligence Tool Gap",
  "type": "object",
  "required": ["tool_gap_id", "gap_type", "metric_candidate_id", "method_pattern_ids", "target_agents", "research_origin", "priority_bucket", "priority_reasons", "blocking_issues", "owner", "status"],
  "properties": {
    "data_decision_status": {"type": "string", "minLength": 1},
    "shadow_implementation_status": {"type": "string", "minLength": 1},
    "license_status": {"enum": ["approved", "pending_review", "restricted", "prohibited"]},
    "pit_feasibility_status": {"enum": ["pit_feasible_pending_vendor_review", "requires_pit_backfill_review", "pit_blocked"]},
    "engineering_effort": {"enum": ["low", "medium", "high"]},
    "requested_tools": {"type": "array", "items": {"type": "string"}},
    "data_review": {"type": "object"},
    "tool_review": {"type": "object"},
    "tool_gap_id": {"type": "string", "minLength": 1},
    "gap_type": {"type": "string", "minLength": 1},
    "metric_candidate_id": {"type": "string"},
    "metric_name": {"type": "string"},
    "method_pattern_ids": {"type": "array", "items": {"type": "string"}},
    "target_agents": {"type": "array", "items": {"type": "string"}},
    "research_origin": {"type": "object"},
    "priority_bucket": {"type": "string", "minLength": 1},
    "priority_reasons": {"type": "array", "items": {"type": "string"}},
    "blocking_issues": {"type": "array", "items": {"type": "string"}},
    "owner": {"type": "string", "minLength": 1},
    "status": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
