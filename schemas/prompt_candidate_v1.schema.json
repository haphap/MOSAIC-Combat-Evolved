{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "prompt_candidate_v1"
    },
    "candidateId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "parentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "parentPromptCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "parentPromptHashes": {
      "type": "object",
      "properties": {
        "zh": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "en": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "zh",
        "en"
      ],
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "agentId": {
          "type": "string",
          "enum": [
            "china",
            "us_economy",
            "eu_economy",
            "central_bank",
            "us_financial_conditions",
            "euro_area_financial_conditions",
            "commodities",
            "geopolitical",
            "market_breadth",
            "institutional_flow",
            "semiconductor",
            "technology",
            "energy",
            "biotech",
            "consumer",
            "industrials",
            "real_estate_construction",
            "financials",
            "agriculture",
            "relationship_mapper",
            "druckenmiller",
            "munger",
            "burry",
            "ackman",
            "cro",
            "alpha_discovery",
            "autonomous_execution",
            "cio"
          ]
        },
        "stage": {
          "type": "string",
          "enum": [
            "agent_run",
            "alpha_discovery",
            "cio_proposal",
            "cro_review",
            "execution_feasibility",
            "cio_final"
          ]
        },
        "cohort": {
          "type": "string",
          "pattern": "^cohort_[a-z0-9_]+$"
        }
      },
      "required": [
        "agentId",
        "stage",
        "cohort"
      ],
      "additionalProperties": false
    },
    "promptRefs": {
      "type": "object",
      "properties": {
        "zh": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\r\\n]+$"
        },
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\r\\n]+$"
        }
      },
      "required": [
        "zh",
        "en"
      ],
      "additionalProperties": false
    },
    "promptHashes": {
      "type": "object",
      "properties": {
        "zh": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "en": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "zh",
        "en"
      ],
      "additionalProperties": false
    },
    "trainingSnapshotId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "trainingSnapshotHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "excludedSampleIdsHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "mutatorConfigHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "mutatorCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "mutationCategories": {
      "minItems": 1,
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "EVIDENCE_PRIORITY",
          "TEMPORAL_DISCIPLINE",
          "CONFLICT_RESOLUTION",
          "TRANSMISSION_CLARITY",
          "UNCERTAINTY_CALIBRATION",
          "TAIL_RISK_CONTROL"
        ]
      }
    },
    "mutationSummary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "alignmentVerifierVersion": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$"
    },
    "behaviorAlignmentHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "behaviorContractHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "privateLineageHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "privateStateArtifactHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "schemaVersion",
    "candidateId",
    "parentId",
    "parentPromptCommit",
    "parentPromptHashes",
    "target",
    "promptRefs",
    "promptHashes",
    "trainingSnapshotId",
    "trainingSnapshotHash",
    "excludedSampleIdsHash",
    "mutatorConfigHash",
    "mutatorCommit",
    "mutationCategories",
    "mutationSummary",
    "hypothesis",
    "alignmentVerifierVersion",
    "behaviorAlignmentHash",
    "behaviorContractHash",
    "privateLineageHash",
    "privateStateArtifactHash",
    "createdAt"
  ],
  "additionalProperties": false
}
