{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Geopolitical continuous source preflight receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_id",
    "adapter_contract_hash",
    "required_continuous_days",
    "observed_continuous_days",
    "window_started_at",
    "window_completed_at",
    "expected_poll_interval_minutes",
    "expected_slot_count",
    "observed_slot_count",
    "slot_capture_ids",
    "missing_slot_starts",
    "failed_capture_ids",
    "availability_ratio",
    "p95_capture_lag_minutes",
    "schema_verified",
    "pagination_verified",
    "publication_time_verified",
    "license_decision_id",
    "license_verified",
    "status",
    "receipt_id",
    "receipt_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "geopolitical_continuous_preflight_receipt_v1"
    },
    "source_id": { "$ref": "#/$defs/id" },
    "adapter_contract_hash": { "$ref": "#/$defs/hash" },
    "required_continuous_days": { "const": 30 },
    "observed_continuous_days": {
      "type": "integer",
      "minimum": 0,
      "maximum": 30
    },
    "window_started_at": { "type": "string", "format": "date-time" },
    "window_completed_at": { "type": "string", "format": "date-time" },
    "expected_poll_interval_minutes": { "type": "integer", "minimum": 1 },
    "expected_slot_count": { "type": "integer", "minimum": 1 },
    "observed_slot_count": { "type": "integer", "minimum": 0 },
    "slot_capture_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "missing_slot_starts": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "format": "date-time" }
    },
    "failed_capture_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "availability_ratio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "p95_capture_lag_minutes": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "schema_verified": { "type": "boolean" },
    "pagination_verified": { "type": "boolean" },
    "publication_time_verified": { "type": "boolean" },
    "license_decision_id": { "$ref": "#/$defs/id" },
    "license_verified": { "type": "boolean" },
    "status": { "enum": ["READY", "PREFLIGHT_REQUIRED"] },
    "receipt_id": { "$ref": "#/$defs/id" },
    "receipt_hash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
