{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "prompt_training_history_v1"
    },
    "exporterVersion": {
      "type": "string",
      "const": "prompt_training_history_exporter_v1"
    },
    "target": {
      "type": "object",
      "properties": {
        "agentId": {
          "type": "string",
          "enum": [
            "china",
            "us_economy",
            "eu_economy",
            "central_bank",
            "us_financial_conditions",
            "euro_area_financial_conditions",
            "commodities",
            "geopolitical",
            "market_breadth",
            "institutional_flow",
            "semiconductor",
            "technology",
            "energy",
            "biotech",
            "consumer",
            "industrials",
            "real_estate_construction",
            "financials",
            "agriculture",
            "relationship_mapper",
            "druckenmiller",
            "munger",
            "burry",
            "ackman",
            "cro",
            "alpha_discovery",
            "autonomous_execution",
            "cio"
          ]
        },
        "stage": {
          "type": "string",
          "enum": [
            "agent_run",
            "alpha_discovery",
            "cio_proposal",
            "cro_review",
            "execution_feasibility",
            "cio_final"
          ]
        },
        "cohort": {
          "type": "string",
          "pattern": "^cohort_[a-z0-9_]+$"
        }
      },
      "required": [
        "agentId",
        "stage",
        "cohort"
      ],
      "additionalProperties": false
    },
    "cutoffAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "outcomeContractVersion": {
      "type": "string",
      "minLength": 1
    },
    "metricFamily": {
      "type": "string",
      "minLength": 1
    },
    "primaryLabelId": {
      "type": "string",
      "minLength": 1
    },
    "excludedSampleIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sampleId": {
            "type": "string",
            "minLength": 1
          },
          "agentOutputRef": {
            "type": "string",
            "minLength": 1
          },
          "agentOutputHash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "outcomeLabelRef": {
            "type": "string",
            "minLength": 1
          },
          "outcomeLabelHash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "asOf": {
            "anyOf": [
              {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
              },
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              }
            ]
          },
          "maturedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "promptBehaviorVersion": {
            "type": "string",
            "minLength": 1
          },
          "normalizedScore": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "rawMetrics": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "acceptedPayload": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "componentSignals": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "component": {
                  "type": "string",
                  "minLength": 1
                },
                "signal": {
                  "type": "number",
                  "minimum": -1,
                  "maximum": 1
                },
                "effective_confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "component",
                "signal",
                "effective_confidence"
              ],
              "additionalProperties": false
            }
          },
          "supportingAcceptedPayloads": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "sampleId",
          "agentOutputRef",
          "agentOutputHash",
          "outcomeLabelRef",
          "outcomeLabelHash",
          "asOf",
          "maturedAt",
          "promptBehaviorVersion",
          "normalizedScore",
          "rawMetrics",
          "acceptedPayload",
          "componentSignals",
          "supportingAcceptedPayloads"
        ],
        "additionalProperties": false
      }
    },
    "validationExperiments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "candidateId": {
            "type": "string",
            "minLength": 1
          },
          "candidatePrivateLineageHash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "experimentId": {
            "type": "string",
            "minLength": 1
          },
          "evaluatorVersion": {
            "type": "string",
            "minLength": 1
          },
          "evaluatorConfigHash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "codeCommit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "validationPairCount": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "validationCandidateMean": {
            "type": "number"
          },
          "validationChampionMean": {
            "type": "number"
          },
          "validationPairedDelta": {
            "type": "number"
          },
          "validationPairDeltas": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "validationFailureCaseRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "validationCompletedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          }
        },
        "required": [
          "candidateId",
          "candidatePrivateLineageHash",
          "experimentId",
          "evaluatorVersion",
          "evaluatorConfigHash",
          "codeCommit",
          "validationPairCount",
          "validationCandidateMean",
          "validationChampionMean",
          "validationPairedDelta",
          "validationPairDeltas",
          "validationFailureCaseRefs",
          "validationCompletedAt"
        ],
        "additionalProperties": false
      }
    },
    "historyHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "exporterVersion",
    "target",
    "cutoffAt",
    "outcomeContractVersion",
    "metricFamily",
    "primaryLabelId",
    "excludedSampleIds",
    "records",
    "validationExperiments",
    "historyHash"
  ],
  "additionalProperties": false
}
