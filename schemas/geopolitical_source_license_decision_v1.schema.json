{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Geopolitical source license decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_id",
    "decision_hash",
    "source_id",
    "decision_status",
    "decided_at",
    "authority_id",
    "permitted_use",
    "raw_source_content_commit_allowed"
  ],
  "properties": {
    "schema_version": {
      "const": "geopolitical_source_license_decision_v1"
    },
    "decision_id": { "$ref": "#/$defs/id" },
    "decision_hash": { "$ref": "#/$defs/hash" },
    "source_id": { "$ref": "#/$defs/id" },
    "decision_status": { "enum": ["APPROVED", "BLOCKED"] },
    "decided_at": { "type": "string", "format": "date-time" },
    "authority_id": { "$ref": "#/$defs/id" },
    "permitted_use": {
      "const": "PUBLIC_METADATA_HASH_AND_DERIVED_EVENT"
    },
    "raw_source_content_commit_allowed": { "const": false }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
