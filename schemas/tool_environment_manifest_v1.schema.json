{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "tool_environment_manifest_v1"
    },
    "source_agent_tool_manifest_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "capability_binding_manifest_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "staged_agent_tool_contract_manifest_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "environments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "agent_id": {
            "type": "string",
            "minLength": 1
          },
          "stage": {
            "type": "string",
            "minLength": 1
          },
          "phase": {
            "type": "string",
            "minLength": 1
          },
          "allowed_tools": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "binding_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^binding:[0-9a-f]{64}$"
            }
          },
          "argument_schema_hashes": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "authorized_query_domain_hashes": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "snapshot_bundle_contract_version": {
            "type": "string",
            "minLength": 1
          },
          "query_bundle_contract_version": {
            "type": "string",
            "minLength": 1
          },
          "materializer_contract_hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "capability_contract_version": {
            "type": "string",
            "minLength": 1
          },
          "privacy_contract_hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "execution_behavior_release_id": {
            "type": "string",
            "minLength": 1
          },
          "execution_behavior_release_hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "code_commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "activation_state": {
            "const": "staged_contract_for_active_surface"
          }
        },
        "required": [
          "agent_id",
          "stage",
          "phase",
          "allowed_tools",
          "binding_ids",
          "argument_schema_hashes",
          "authorized_query_domain_hashes",
          "snapshot_bundle_contract_version",
          "query_bundle_contract_version",
          "materializer_contract_hash",
          "capability_contract_version",
          "privacy_contract_hash",
          "execution_behavior_release_id",
          "execution_behavior_release_hash",
          "code_commit",
          "activation_state"
        ],
        "additionalProperties": false
      }
    },
    "manifest_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "source_agent_tool_manifest_hash",
    "capability_binding_manifest_hash",
    "staged_agent_tool_contract_manifest_hash",
    "environments",
    "manifest_hash"
  ],
  "additionalProperties": false
}
