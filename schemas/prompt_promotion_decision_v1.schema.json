{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "prompt_promotion_decision_v1"
    },
    "decisionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "experimentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "familyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "candidateId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "policyVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "policyConfigHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "decision": {
      "type": "string",
      "enum": [
        "ELIGIBLE",
        "REJECTED"
      ]
    },
    "reasons": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "metricSummary": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "number"
      }
    },
    "evidenceHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "decidedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "schemaVersion",
    "decisionId",
    "experimentId",
    "familyId",
    "candidateId",
    "policyVersion",
    "policyConfigHash",
    "decision",
    "reasons",
    "metricSummary",
    "evidenceHash",
    "decidedAt"
  ],
  "additionalProperties": false
}
