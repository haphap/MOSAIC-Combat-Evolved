{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": { "const": "capability_full_bundle_v1" },
    "prompt_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "execution_behavior_release_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "production_variant_roster_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "runtime_agent_manifest_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "agent_tool_manifest_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "tool_environment_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "capability_binding_manifest_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "knot_coverage_manifest_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "knot_audit_capability_track_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "private_companion_pin_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "full_bundle_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "required": [
    "schema_version",
    "prompt_hash",
    "execution_behavior_release_hash",
    "production_variant_roster_hash",
    "runtime_agent_manifest_hash",
    "agent_tool_manifest_hash",
    "tool_environment_hash",
    "capability_binding_manifest_hash",
    "knot_coverage_manifest_hash",
    "knot_audit_capability_track_hash",
    "private_companion_pin_hash",
    "full_bundle_hash"
  ],
  "additionalProperties": false
}
