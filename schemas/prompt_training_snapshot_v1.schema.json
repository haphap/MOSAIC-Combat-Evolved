{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "prompt_training_snapshot_v1"
    },
    "target": {
      "type": "object",
      "properties": {
        "agentId": {
          "type": "string",
          "enum": [
            "china",
            "us_economy",
            "eu_economy",
            "central_bank",
            "us_financial_conditions",
            "euro_area_financial_conditions",
            "commodities",
            "geopolitical",
            "market_breadth",
            "institutional_flow",
            "semiconductor",
            "technology",
            "energy",
            "biotech",
            "consumer",
            "industrials",
            "real_estate_construction",
            "financials",
            "agriculture",
            "relationship_mapper",
            "druckenmiller",
            "munger",
            "burry",
            "ackman",
            "cro",
            "alpha_discovery",
            "autonomous_execution",
            "cio"
          ]
        },
        "stage": {
          "type": "string",
          "enum": [
            "agent_run",
            "alpha_discovery",
            "cio_proposal",
            "cro_review",
            "execution_feasibility",
            "cio_final"
          ]
        },
        "cohort": {
          "type": "string",
          "pattern": "^cohort_[a-z0-9_]+$"
        }
      },
      "required": [
        "agentId",
        "stage",
        "cohort"
      ],
      "additionalProperties": false
    },
    "snapshotId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "snapshotHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "datasetSnapshotHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "cutoffAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "outcomeContractVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "evaluatorVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "matureSampleCount": {
      "type": "integer",
      "minimum": 30,
      "maximum": 9007199254740991
    },
    "scoreSummary": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "number"
      }
    },
    "failureCategoryCounts": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "tailFailureCaseRefs": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[^\\r\\n]+$"
      }
    },
    "evidenceGapSummaries": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "behaviorFeedback": {
      "type": "object",
      "properties": {
        "contractHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "facets": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "matureSampleCount": {
                "type": "integer",
                "minimum": 30,
                "maximum": 9007199254740991
              },
              "meanScore": {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              },
              "lowerTailScore": {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              },
              "failureCategoryCounts": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "minLength": 1
                },
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              }
            },
            "required": [
              "matureSampleCount",
              "meanScore",
              "lowerTailScore",
              "failureCategoryCounts"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "contractHash",
        "facets"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "target",
    "snapshotId",
    "snapshotHash",
    "datasetSnapshotHash",
    "cutoffAt",
    "outcomeContractVersion",
    "evaluatorVersion",
    "matureSampleCount",
    "scoreSummary",
    "failureCategoryCounts",
    "tailFailureCaseRefs",
    "evidenceGapSummaries",
    "behaviorFeedback"
  ],
  "additionalProperties": false
}
